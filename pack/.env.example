# CCI The Pack — local preview.
# Mock fixtures only. Do not add live CCI credentials or exchange keys.
# PACK_BOT_TOKEN stays empty until a real Mini App bot is configured outside this file.
# PACK_SESSION_SECRET below is a placeholder. Replace it locally. Do not commit a real secret.

CCI_SOURCE=mock
LIVE_CCI=false
PACK_ENV=dev
APP_ENV=dev
DEV_BROWSER_MODE=true

DATABASE_URL=postgresql+psycopg://pack:pack@127.0.0.1:5432/pack
PACK_SESSION_SECRET=local-dev-only-not-a-secret
# initData HMAC. PACK_TELEGRAM_BOT_TOKEN wins when it is set.
# Never put the CCI production bot token here.
PACK_BOT_TOKEN=
PACK_TELEGRAM_BOT_TOKEN=
PACK_MINI_APP_URL=http://localhost:5173
# Telegram sends this as X-Telegram-Bot-Api-Secret-Token. Empty means the webhook returns 503.
# Do not commit a real secret. A missing value does not stop API boot.
PACK_WEBHOOK_SECRET=
BOT_REQUIRED=false
AUTH_MAX_AGE_SECONDS=86400

# Optional override. Default is pack/fixtures/missions beside this file's repo root.
# PACK_FIXTURES_DIR=

# Vite dev server (pack/apps/web). Leave unset to use the local proxy.
# VITE_API_BASE=
# VITE_PACK_ENV=dev
# VITE_PROXY_TARGET=http://127.0.0.1:8000
